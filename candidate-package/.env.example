# Copy this file to .env and fill in your key. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-...

# Two models by OpenRouter slug — cheap/fast for intent+extraction,
# stronger for the LLM-as-judge eval checks. Swap freely; the cost/latency
# tradeoff is something to justify in the write-up, not to get "right".
INTENT_MODEL=z-ai/glm-5.3-flash
JUDGE_MODEL=deepseek/deepseek-v4-flash-0731
